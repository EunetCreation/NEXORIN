APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

NEXORIN_SLD_ALLOW_VECTOR_FALLBACK=false
NEXORIN_NODE_BINARY="C:/Program Files/nodejs/node.exe"
NEXORIN_PREMIUM_PDF_ALLOW_FALLBACK=false
NEXORIN_PDF_TIMEOUT=120
NEXORIN_PDF_NAVIGATION_TIMEOUT=60000
NEXORIN_PDF_TEMP_DIR="D:/ACADEMIC/TA/NEXORIN SUITE/NEXORIN/NEXORIN-APP/storage/app/pdf-renderer/process-temp"
NEXORIN_CHROMIUM_PATH=

#Nexorin industrial Datasheet parser
NEXORIN_DATASHEET_PARSER_VERSION=64B-multivariant-v1
NEXORIN_DATASHEET_MAX_UPLOAD_KB=10240
NEXORIN_PDFTOTEXT_BINARY="C:/Users/USER/AppData/Local/Microsoft/WinGet/Packages/oschwartz10612.Poppler_Microsoft.Winget.Source_8wekyb3d8bbwe/poppler-25.07.0/Library/bin/pdftotext.exe"
NEXORIN_DATASHEET_PROCESS_TIMEOUT=20
NEXORIN_DATASHEET_MAX_TEXT_LENGTH=200000

# Live operational context
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com
OPEN_METEO_TIMEOUT=6

# Configure a commercial/customer endpoint and API key for production-scale use.
OPEN_METEO_API_KEY=
NOMINATIM_ENABLED=false
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_TIMEOUT=6
NOMINATIM_MINIMUM_INTERVAL_MS=1100
NOMINATIM_USER_AGENT="NEXORIN/1.0 (https://your-domain.example; ops@your-domain.example)"
NOMINATIM_CONTACT_EMAIL=ops@your-domain.example

# NEXORIN enterprise authentication
GOOGLE_SSO_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
